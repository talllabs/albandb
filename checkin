
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Check-in | PH18</title>
    
    <meta name="robots" content="noindex, nofollow">

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    
    <style>
        /* --- SHARED CSS STYLES --- */
        :root {
            --bg-color: #2e2e48;
            --text-color: #f4f4f4;
            --accent-gold: #d4af37;
            --glass-bg: rgba(20, 20, 35, 0.6);
            --glass-border: rgba(255, 255, 255, 0.1);
            --card-bg: rgba(255, 255, 255, 0.05);
        }

        body {
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            padding: 0;
            line-height: 1.7;
            background-color: var(--bg-color);
            color: var(--text-color);
            -webkit-font-smoothing: antialiased;
        }

        /* --- LOGIN SCREEN --- */
        #login-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: var(--bg-color);
            z-index: 9999;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .login-box {
            background: var(--glass-bg);
            backdrop-filter: blur(12px);
            padding: 3rem;
            border: 1px solid var(--glass-border);
            text-align: center;
            max-width: 400px;
            width: 100%;
            box-shadow: 0 20px 60px rgba(0,0,0,0.4);
        }

        .login-box h2 {
            font-family: 'Playfair Display', serif;
            color: var(--accent-gold);
            margin-top: 0;
        }

        .login-input {
            width: 100%;
            padding: 15px;
            margin: 20px 0;
            background: transparent;
            border: none;
            border-bottom: 1px solid rgba(255,255,255,0.3);
            color: white;
            font-size: 1.2rem;
            text-align: center;
            font-family: 'Montserrat', sans-serif;
            letter-spacing: 5px;
        }
        .login-input:focus { outline: none; border-bottom-color: var(--accent-gold); }

        .login-btn {
            background: transparent;
            border: 1px solid var(--accent-gold);
            color: var(--accent-gold);
            padding: 12px 30px;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }
        .login-btn:hover { background: var(--accent-gold); color: #2e2e48; }

        /* --- MAIN CONTENT (HIDDEN INITIALLY) --- */
        #protected-content {
            display: none; /* Hidden by default */
            max-width: 800px;
            margin: 0 auto;
            padding: 4rem 1.5rem;
        }

        h1, h2, h3 { font-family: 'Playfair Display', serif; color: #fff; }
        
        h1 {
            font-size: 3rem;
            text-align: center;
            margin-bottom: 0.5rem;
        }

        .subtitle {
            text-align: center;
            color: var(--accent-gold);
            letter-spacing: 2px;
            text-transform: uppercase;
            font-size: 0.8rem;
            margin-bottom: 4rem;
        }

        /* --- INFO CARDS --- */
        .info-card {
            background: var(--card-bg);
            border: 1px solid var(--glass-border);
            padding: 2.5rem;
            margin-bottom: 2rem;
            backdrop-filter: blur(5px);
        }

        .info-card h2 {
            font-size: 1.8rem;
            border-bottom: 1px solid var(--glass-border);
            padding-bottom: 1rem;
            margin-top: 0;
            color: var(--accent-gold);
        }

        .info-card h3 {
            font-size: 1.1rem;
            margin-top: 2rem;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255,255,255,0.8);
        }

        .highlight-box {
            background: rgba(212, 175, 55, 0.1);
            border-left: 3px solid var(--accent-gold);
            padding: 1.5rem;
            margin: 1.5rem 0;
        }

        .big-code {
            font-size: 2.5rem;
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            color: #fff;
            letter-spacing: 5px;
            display: block;
            margin: 10px 0;
        }

        .address-block {
            font-size: 1.2rem;
            line-height: 1.8;
            font-style: italic;
            font-family: 'Playfair Display', serif;
        }

        ul { padding-left: 20px; }
        li { margin-bottom: 10px; opacity: 0.9; }

        .warning { color: #ff8a8a; font-weight: 500; }

        footer {
            text-align: center;
            margin-top: 4rem;
            opacity: 0.6;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        @media (max-width: 600px) {
            h1 { font-size: 2.2rem; }
            .info-card { padding: 1.5rem; }
            .big-code { font-size: 1.8rem; letter-spacing: 2px; }
        }
    </style>
</head>
<body>

    <div id="login-overlay">
        <div class="login-box">
            <h2>Guest Access</h2>
            <p style="opacity: 0.7; font-size: 0.9rem;">Please enter the PIN provided for your stay.</p>
            <input type="password" id="passwordInput" class="login-input" placeholder="PIN" onkeyup="checkEnter(event)">
            <button class="login-btn" onclick="checkPassword()">Unlock</button>
            <p id="error-msg" style="color: #ff8a8a; display: none; margin-top: 15px; font-size: 0.8rem;">Incorrect PIN</p>
        </div>
    </div>

    <div id="protected-content">
        
        <h1>Welcome to PH18</h1>
        <div class="subtitle">Check-in & House Guide</div>

        <div class="info-card">
            <h2>Address</h2>
            <div class="address-block">
                4314 Marina City Drive, PH18<br>
                Marina del Rey, California 90292<br>
                United States
            </div>
            <p style="margin-top: 20px; font-size: 0.9rem; opacity: 0.8;">
                Building Management and Security (at the gate) are onsite and available should there be issues/concerns with building/grounds (e.g., elevators).
            </p>
        </div>

        <div class="info-card">
            <h2>Arrival & Parking</h2>
            
            <h3>1. Security Gate</h3>
            <ul>
                <li>Check-in at the Security Gate.</li>
                <li>Give the guard your name and state you are going to <strong>PH18</strong>.</li>
                <li>Proceed straight ahead towards the <strong>Center Tower</strong> for parking.</li>
            </ul>

            <h3>2. Parking</h3>
            <ul>
                <li>Enter the Tower and Turn <strong>Left</strong> at the Stop Sign.</li>
                <li>Look for your spot on your <strong>IMMEDIATE right</strong>.</li>
                <li><strong>Space #258</strong> (You can move the “No Parking” sign).</li>
                <li>Alternative: Just a couple of spots down is <strong>Space #264</strong>.</li>
            </ul>

            <h3>3. Elevator Access</h3>
            <p>Directly across from the parking is the elevator to the Penthouse (PH). When you arrive at the Penthouse level, take a <strong>left</strong> from the elevator lobby and head to PH18.</p>
        </div>

        <div class="info-card">
            <h2>Access Code</h2>
            <p>Touch keypad and hold until the numbers illuminate. Enter the code below and press the circular button at the end.</p>
            
            <div class="highlight-box" style="text-align: center;">
                <span class="big-code">98765432</span>
            </div>

            <h3>Door Tips</h3>
            <p>If you have difficulty opening the door, make sure it is closed tight by <strong>pulling the door towards you</strong> to engage the latch, then try inputting the code again.</p>
            
            <h3>Important: Locking Logic</h3>
            <ul>
                <li><strong>Automatic Lock:</strong> The LOCKLY keypad automatically locks itself. Do not manually turn the lock from the outside.</li>
                <li><strong>Exiting:</strong> Manually unlock by turning the top LOCKLY knob to the unlocked position. It will re-lock automatically a few seconds after you exit. Ensure the door is securely shut.</li>
            </ul>
        </div>

        <div class="info-card">
            <h2>WiFi</h2>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                <div>
                    <span style="display:block; font-size: 0.7rem; text-transform: uppercase; opacity: 0.6;">Network</span>
                    <span style="font-size: 1.2rem; color: #fff;">Spectrum Set-up-15</span>
                </div>
                <div>
                    <span style="display:block; font-size: 0.7rem; text-transform: uppercase; opacity: 0.6;">Password</span>
                    <span style="font-size: 1.2rem; color: var(--accent-gold);">awaybeer490</span>
                </div>
            </div>
        </div>

        <div class="info-card">
            <h2>House Details</h2>
            
            <h3>Shades</h3>
            <p class="warning">***Please DO NOT open/close the shades. Leave them in the open position.***</p>

            <h3>Patio</h3>
            <p>Remember to close the patio door when you leave.</p>

            <h3>Air Conditioning / Heat</h3>
            <p>There are thermostats on both levels. For downstairs, the thermostat is on the exterior lower bathroom wall under the stairs. <em>Do not use the thermostat near the windows on the downstairs level.</em></p>

            <h3>Cleaning</h3>
            <p>The unit has been professionally cleaned for your arrival. Additional cleaning services are available for a flat rate of $250. Please let us know if you need this.</p>
        </div>

        <div class="info-card">
            <h2>Amenities</h2>
            
            <h3>Coffee / Cafe</h3>
            <ul>
                <li>There is no coffee maker in the unit, but there is an <strong>electric kettle</strong> in the cupboard left of the refrigerator.</li>
                <li><strong>On-site Cafe:</strong> Offers coffee, snacks, sandwiches, etc.</li>
                <li><em>Directions to Cafe:</em> After exiting the elevator into the parking garage, take a right from the elevator lobby, a second right to exit the parking garage, and a third right at the stop sign. Follow the sidewalk.</li>
            </ul>

            <h3>Pool</h3>
            <p>Just past the cafe on the left (catty-corner) you will see stairs leading up to the pool. No key is needed for access.</p>

            <h3>Laundry & Towels</h3>
            <p>In-unit laundry is located at the top of the stairs in the closet. Fresh towels are in the drawers. You may use the laundry as needed.</p>
            
            <h3>Linens</h3>
            <p>Can be left on the bed after your departure. House cleaning will strip and wash after your stay.</p>
        </div>

        <div class="info-card">
            <h2>Trash & Recycling</h2>
            <ul>
                <li>In-Unit trash is below the sink area.</li>
                <li>Please empty trash and recycling at the end of your stay.</li>
                <li><strong>Trash Room:</strong> Located off of the elevator lobby behind the “Electrical Room” door.</li>
            </ul>
        </div>

        <div class="info-card">
            <h2>Local Favorites</h2>
            
            <h3>Dining</h3>
            <ul>
                <li><strong>Salt</strong> (Marina del Rey Hotel)</li>
                <li><strong>Beachside</strong> (Jamaica Bay Inn)</li>
            </ul>

            <h3>Shopping</h3>
            <p><strong>Marina Waterside Shopping Center:</strong> (4700 Admiralty Way). Features Ralph’s Grocery and Mendocino Farms. Complimentary parking available via Fiji Way, Admiralty Way, or Mindanao Way.</p>
            
            <h3>Plan Your Visit</h3>
            <p><a href="https://www.visitmarinadelrey.com/events/" target="_blank" style="color: var(--accent-gold);">Guide to fun events and activities in the Marina</a></p>
        </div>

        <footer>
            <a href="index.html" style="color: rgba(255,255,255,0.5); text-decoration: none;">&larr; Back to Home</a>
            <br><br>
            PH18 &copy; 2026
        </footer>
    </div>

    <script>
        function checkPassword() {
            var input = document.getElementById('passwordInput').value;
            // The magic number
            if(input === '90292') {
                document.getElementById('login-overlay').style.opacity = '0';
                setTimeout(function(){
                    document.getElementById('login-overlay').style.display = 'none';
                    document.getElementById('protected-content').style.display = 'block';
                    // Simple fade in for content
                    document.getElementById('protected-content').style.opacity = '0';
                    setTimeout(function(){
                        document.getElementById('protected-content').style.transition = 'opacity 1s';
                        document.getElementById('protected-content').style.opacity = '1';
                    }, 50);
                }, 500);
            } else {
                document.getElementById('error-msg').style.display = 'block';
                // Shake animation
                var box = document.querySelector('.login-box');
                box.style.transform = 'translateX(10px)';
                setTimeout(function(){ box.style.transform = 'translateX(-10px)'; }, 100);
                setTimeout(function(){ box.style.transform = 'translateX(10px)'; }, 200);
                setTimeout(function(){ box.style.transform = 'translateX(0)'; }, 300);
            }
        }

        function checkEnter(event) {
            if (event.key === "Enter") {
                checkPassword();
            }
        }
    </script>

</body>
</html>

